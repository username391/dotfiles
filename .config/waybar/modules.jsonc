{
    // =================================================
    // Left
    // =================================================

    // Spaces — numbered, Mission Control style
    "hyprland/workspaces": {
        "on-click": "activate",
        "active-only": false,
        "all-outputs": false,
        "format": "{name}",
        "format-icons": {
            "urgent": "",
            "active": "",
            "default": ""
        }
    },

    // Pomodoro timer
    "custom/pomodoro": {
        "format": "{}",
        "return-type": "json",
        "exec": "waybar-module-pomodoro",
        "exec-if": "command -v waybar-module-pomodoro >/dev/null 2>&1",
        "on-click": "waybar-module-pomodoro toggle",
        "on-click-right": "waybar-module-pomodoro reset",
        "tooltip": false
    },

    // Active window — like the focused app name in the macOS menu bar
    "hyprland/window": {
        "format": "{title}",
        "icon": true,
        "icon-size": 16,
        "max-length": 60,
        "rewrite": {
            "(.*) - Brave": "$1",
            "(.*) - Obsidian (.*)": "$1",
            "(.*) - Chromium": "$1",
            "(.*) - Brave Search": "$1",
            "(.*) - Outlook": "$1",
            "(.*) Microsoft Teams": "$1"
        },
        "separate-outputs": true
    },

    // =================================================
    // Right
    // =================================================

    // Input language — plain "EN"/"RU" like macOS input source
    "hyprland/language": {
        "format": "{}",
        "format-en": "EN",
        "format-ru": "RU"
    },

    // Clock
    "clock": {
        "format": "{:%H:%M}",
        "format-alt": "{:%d.%m.%Y}",
        "on-click": "toggle",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "month",
            "mode-mon-col": 3,
            "weeks-pos": "right",
            "on-click-right": "mode",
            "start-of-week": "mo",
            "format": {
                "months": "<span color='#f5f5f7'><b>{}</b></span>",
                "days": "<span color='#d1d1d6'><b>{}</b></span>",
                "weeks": "<span color='#8e8e93'><b>W{}</b></span>",
                "weekdays": "<span color='#ffd60a'><b>{}</b></span>",
                "today": "<span color='#0a84ff'><b><u>{}</u></b></span>"
            }
        }
    },

    // Battery
    "battery": {
        "states": {
            "good": 95,
            "warning": 30,
            "critical": 15
        },
        "format": "{capacity}% {icon}",
        "format-charging": "{capacity}% 󰂄",
        "format-plugged": "{capacity}% 󰂄",
        "format-alt": "{icon} {time}",
        "format-icons": [
            "󰁺", "󰁻", "󰁼", "󰁽", "󰁾",
            "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"
        ],
        "tooltip-format": "{timeTo} / {capacity}%"
    },

    // Volume — icon only, tooltip carries the details
    "pulseaudio": {
        "format": "{icon}",
        "format-muted": "󰝟",
        "format-icons": {
            "headphone": "󰋋",
            "headset": "󰋋",
            "default": [
                "󰕿", "󰖀", "󰕾"
            ]
        },
        "tooltip-format": "{desc} — {volume}%",
        "scroll-step": 5,
        "on-click": "pavucontrol",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    },

    // Wi-Fi / Ethernet
    "network": {
        "interval": 5,
        "format-wifi": "{icon}",
        "format-ethernet": "󰈀",
        "format-linked": "󰈀",
        "format-disconnected": "󰖪",
        "format-icons": [
            "󰤯", "󰤟", "󰤢", "󰤥", "󰤨"
        ],
        "tooltip-format": "{ifname}",
        "tooltip-format-wifi": "{essid} ({signalStrength}%)",
        "tooltip-format-ethernet": "{ifname} ({ipaddr}/{cidr})",
        "tooltip-format-disconnected": "Нет подключения",
        "on-click": "kitty -e nmtui"
    },

    // Bluetooth
    "bluetooth": {
        "format": "{icon}",
        "format-disabled": "󰂲",
        "format-off": "󰂲",
        "format-connected": "󰂱",
        "format-no-controller": "",
        "interval": 30,
        "tooltip-format": "{device_alias} — {device_battery_percentage}%",
        "tooltip-format-disabled": "Bluetooth выключен",
        "on-click": "blueman-manager"
    },

    // Status icons (menu bar extras)
    "tray": {
        "icon-size": 17,
        "spacing": 4,
        "show-passive-items": true
    },

    // Notification center
    "custom/swaync": {
        "tooltip": true,
        "format": "{icon}",
        "format-icons": {
            "notification": "󰍝",
            "none": "󰍜",
            "dnd-notification": "󰂛",
            "dnd-none": "󰂛",
            "inhibited-notification": "󰍝",
            "inhibited-none": "󰍜",
            "dnd-inhibited-notification": "󰂛",
            "dnd-inhibited-none": "󰂛"
        },
        "return-type": "json",
        "exec-if": "which swaync-client",
        "exec": "swaync-client -swb",
        "on-click": "sleep 0.1 && swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw",
        "escape": true
    }
}
