// -*- mode: jsonc -*-
// macOS-inspired bottom panel.
// Modules and their order are preserved from the previous config.
{
    "layer": "top",
    "position": "bottom",
    "height": 38,
    "spacing": 0,

    // Docked to the bottom edge (no margins).
    "include": [
        "~/.config/waybar/modules.jsonc"
    ],

    "modules-left": [
        "hyprland/workspaces",
        "custom/pomodoro",
        "hyprland/window"
    ],
    "modules-center": [],
    "modules-right": [
        "hyprland/language",
        "clock",
        "battery",
        "pulseaudio",
        "network",
        "bluetooth",
        "tray",
        "custom/swaync"
    ]
}
