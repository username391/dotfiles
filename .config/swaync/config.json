{
    "$schema": "/etc/xdg/swaync/configSchema.json",
    "positionX": "right",
    "positionY": "top",
    "cssPriority": "user",
    "control-center-width": 380,
    "control-center-height": 860,
    "control-center-margin-top": 2,
    "control-center-margin-bottom": 2,
    "control-center-margin-right": 1,
    "control-center-margin-left": 0,
    "notification-window-width": 400,
    "notification-body-image-height": 160,
    "notification-body-image-width": 200,
    "timeout": 4,
    "timeout-low": 2,
    "timeout-critical": 6,
    "fit-to-screen": false,
    "keyboard-shortcuts": true,
    "image-visibility": "when-available",
    "transition-time": 200,
    "hide-on-clear": false,
    "hide-on-action": false,
    "script-fail-notify": true,
    "scripts": {
        "bluetooth-status": {
            "exec": "~/.config/swaync/scripts/bluetooth.sh",
            "urgency": "Normal"
        }
    },
    "notification-visibility": {
        "example-name": {
            "state": "muted",
            "urgency": "Low",
            "app-name": "Spotify"
        }
    },
    "widgets": [
        "buttons-grid",
        "volume",
        "backlight",
        "scripts",
        "mpris",
        "title",
        "dnd",
        "notifications"
    ],
    "widget-config": {
        "title": {
            "text": "Notifications",
            "clear-all-button": true,
            "button-text": " 󰎟 "
        },
        "dnd": {
            "text": "Do not disturb"
        },
        "label": {
            "max-lines": 1,
            "text": " "
        },
        "mpris": {},
        "volume": {
            "label": "󰕾",
            "show-per-app": false
        },
        "backlight": {
            "label": "󰃠",
            "device": "amdgpu_bl1",
            "subsystem": "backlight"
        },
        "buttons-grid": {
            "buttons-per-row": 3,
            "actions": [
                {
                    "label": "󰖩",
                    "type": "toggle",
                    "command": "sh -c '[[ $SWAYNC_TOGGLE_STATE == true ]] && nmcli radio wifi on || nmcli radio wifi off'",
                    "update-command": "sh -c '[[ $(nmcli radio wifi) == \"enabled\" ]] && echo true || echo false'"
                },
                {
                    "label": "󰂯",
                    "type": "toggle",
                    "command": "sh -c '[[ $SWAYNC_TOGGLE_STATE == true ]] && bluetoothctl power on || bluetoothctl power off'",
                    "update-command": "sh -c 'bluetoothctl show | grep -q \"Powered: yes\" && echo true || echo false'"
                },
                {
                    "label": "󰒓",
                    "command": "blueman-manager"
                },
                {
                    "label": "󰍬",
                    "type": "toggle",
                    "command": "sh -c 'amixer set Capture toggle'",
                    "update-command": "sh -c 'amixer sget Capture | grep -q \"\\[on\\]\" && echo true || echo false'"
                },
                {
                    "label": "󰄀",
                    "command": "~/.config/swaync/scripts/screenshot.sh"
                },
                {
                    "label": "󰐥",
                    "command": "wlogout -b 5"
                }
            ]
        }
    }
}
